{
  "name": "hbic-calgary-app",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone Hazrat Bilal Islamic Centre mobile app, admin dashboard, public website, and Firebase scaffold.",
  "workspaces": [
    "apps/mobile",
    "apps/admin-web",
    "apps/public-web",
    "packages/shared",
    "packages/ui",
    "packages/config",
    "backend/functions"
  ],
  "scripts": {
    "dev:mobile": "npm --workspace @hbic/mobile run start",
    "dev:admin": "npm --workspace @hbic/admin-web run dev",
    "dev:web": "npm --workspace @hbic/public-web run dev",
    "typecheck": "npm --workspaces --if-present run typecheck",
    "lint": "npm --workspaces --if-present run lint",
    "build:web": "npm --workspace @hbic/public-web run build",
    "build:admin": "npm --workspace @hbic/admin-web run build",
    "test:prayer": "tsx --test packages/shared/test/prayer.test.ts",
    "test:companion": "tsx --test packages/shared/test/bilalCompanion.test.ts packages/shared/test/bilalTour.test.ts apps/public-web/test/bilalCompanionKnowledge.test.ts apps/public-web/test/bilalCompanionRoute.test.mts apps/public-web/test/bilalCompanionRendering.test.mts apps/mobile/test/bilalCompanionRendering.test.mts",
    "test:prayer-sync": "tsx --test apps/public-web/test/prayerSync.test.ts",
    "test:onboarding": "tsx --test apps/mobile/test/onboarding.test.ts",
    "test:content": "tsx --test apps/mobile/test/contentLifecycle.test.mts",
    "test:rating": "tsx --test apps/mobile/test/ratingCampaign.test.ts apps/mobile/test/ratingRendering.test.mts apps/public-web/test/ratingPublication.test.mts apps/admin-web/test/ratingAdminRendering.test.mts",
    "test:admin-auth": "tsx --test apps/public-web/test/adminAuth.test.ts",
    "test:display": "tsx --test apps/public-web/test/tvDisplay.test.ts",
    "test:halal": "tsx --test packages/shared/test/halal.test.ts",
    "test:community": "tsx --test packages/shared/test/community.test.ts",
    "test:notifications": "tsx --test packages/shared/test/notifications.test.ts",
    "test:notification-payload": "tsx --test apps/public-web/test/notificationPayload.test.ts",
    "test:privacy": "tsx --test packages/shared/test/privacy.test.ts",
    "demo:record:web": "tsx demo-recordings/scripts/record-public-site.ts --mode desktop",
    "demo:record:web:mobile": "tsx demo-recordings/scripts/record-public-site.ts --mode mobile",
    "demo:record:web:all": "tsx demo-recordings/scripts/record-public-site.ts --mode all",
    "demo:record:admin": "tsx demo-recordings/scripts/record-admin-dashboard.ts",
    "demo:record:ios": "bash demo-recordings/scripts/record-ios-app.sh",
    "demo:compress": "bash demo-recordings/scripts/compress-videos.sh",
    "seed": "npm --workspace @hbic/functions run seed"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@expo/plist": "0.4.8",
    "@expo/prebuild-config": "~54.0.9",
    "@playwright/test": "^1.51.1",
    "expo-router": "6.0.24",
    "ffmpeg-static": "^5.3.0",
    "tsx": "^4.19.0"
  }
}
