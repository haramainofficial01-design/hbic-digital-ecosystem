{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@hbic/shared": ["packages/shared/src/index.ts"],
      "@hbic/shared/*": ["packages/shared/src/*"],
      "@hbic/ui": ["packages/ui/src/index.ts"],
      "@hbic/config": ["packages/config/src/index.ts"]
    }
  }
}
