{
  "configVersion": "v3",
  "app": {
    "appId": 1000000,
    "appName": "Masjid Bilal",
    "appType": "app",
    "version": {
      "code": 1,
      "name": "1.0.0"
    },
    "icon": "icon.png",
    "vender": "Hazrat Bilal Islamic Centre",
    "description": "Canonical prayer and iqamah times for Masjid Bilal Calgary"
  },
  "permissions": ["data:os.device.info", "device:os.local_storage"],
  "runtime": {
    "apiVersion": {
      "compatible": "4.0",
      "target": "4.0",
      "minVersion": "4.0"
    }
  },
  "targets": {
    "common": {
      "module": {
        "page": {
          "pages": ["page/index"]
        },
        "app-side": {
          "path": "app-side/index"
        }
      },
      "platforms": [
        { "st": "r", "dw": 480 },
        { "st": "s", "dw": 390 }
      ]
    }
  },
  "i18n": {
    "en-US": { "appName": "Masjid Bilal" }
  },
  "defaultLanguage": "en-US"
}
