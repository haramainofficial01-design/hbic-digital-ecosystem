{
  "name": "@hbic/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --port 8081",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "native:sync:ios": "expo prebuild --platform ios --clean",
    "native:verify:targets": "node ./scripts/verify-apple-targets.mjs",
    "native:test:snapshot": "swiftc targets/_shared/PrayerSnapshot.swift scripts/test-prayer-snapshot.swift -o \"$TMPDIR/masjid-prayer-snapshot-tests\" && \"$TMPDIR/masjid-prayer-snapshot-tests\""
  },
  "dependencies": {
    "@bacons/apple-targets": "^4.0.7",
    "@expo/vector-icons": "^15.0.3",
    "@formatjs/intl-datetimeformat": "^7.8.0",
    "@formatjs/intl-datetimeformat-calendar-islamic-umalqura": "^1.1.0",
    "@hbic/shared": "0.1.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~54.0.37",
    "expo-application": "~7.0.8",
    "expo-audio": "~1.1.1",
    "expo-constants": "~18.0.14",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-glass-effect": "~0.1.10",
    "expo-haptics": "~15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-sensors": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-task-manager": "~14.0.9",
    "firebase": "^10.13.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "eslint": "^8.57.0",
