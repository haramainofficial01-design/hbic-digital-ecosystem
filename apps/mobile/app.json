{
  "expo": {
    "name": "Masjid Bilal",
    "slug": "hbic-calgary-app",
    "scheme": "hbiccalgary",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/hbic-app-icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/brand/hbic-splash-mark.png",
      "resizeMode": "contain",
      "backgroundColor": "#062238"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ca.hbic.calgary.app",
      "appleTeamId": "ZJ58VWNTX3",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.ca.hbic.calgary.app"
        ]
      },
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/hbic-app-icon.png",
        "backgroundColor": "#062238"
      },
      "package": "ca.hbic.calgary.app",
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.ACTIVITY_RECOGNITION"
      ]
    },
    "plugins": [
      "expo-router",
      "@bacons/apple-targets",
      "./plugins/withAppleTargetSchemes",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25",
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/hbic-splash-mark.png",
          "color": "#0C9BA8",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "79283015-cb87-48ef-9761-81ab87641205"
      }
    },
    "owner": "hbiccas-team"
  }
}
