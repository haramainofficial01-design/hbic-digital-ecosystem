{
  "expo": {
    "name": "HBIC Calgary",
    "slug": "hbic-calgary-app",
    "scheme": "hbiccalgary",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/brand/hbic-app-icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/brand/hbic-splash-mark.png",
      "resizeMode": "contain",
      "backgroundColor": "#062238"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sahil.hbiccalgarypreview"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/hbic-app-icon.png",
        "backgroundColor": "#062238"
      },
      "package": "ca.hbic.calgary.app",
      "versionCode": 1
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "79283015-cb87-48ef-9761-81ab87641205"
      }
    },
    "owner": "hbiccas-team"
  }
}
