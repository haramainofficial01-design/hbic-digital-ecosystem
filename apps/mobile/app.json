{
  "expo": {
    "name": "Masjid Bilal",
    "slug": "hbic-calgary-app",
    "scheme": "hbiccalgary",
    "version": "1.7.3",
    "orientation": "default",
    "icon": "./assets/brand/hbic-app-icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/brand/hbic-splash-mark.png",
      "resizeMode": "contain",
      "backgroundColor": "#062238"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ca.hbic.calgary.app",
      "appleTeamId": "ZJ58VWNTX3",
      "infoPlist": {
        "NSCameraUsageDescription": "Authorized HBIC staff can scan Quran Academy passes for check-in. You can enter the QA reference instead.",
        "NSPhotoLibraryUsageDescription": "Allows HBIC to read a photo you explicitly select for an image attachment. Your photo library is not scanned or accessed in the background.",
        "NSSpeechRecognitionUsageDescription": "Use on-device speech only when you choose Quran voice search. HBIC does not store or upload your voice search."
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.ca.hbic.calgary.app"
        ]
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "permissions": ["CAMERA"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/hbic-app-icon.png",
        "backgroundColor": "#062238"
      },
      "package": "ca.hbic.calgary.app",
      "blockedPermissions": [
        "android.permission.ACTIVITY_RECOGNITION"
      ]
    },
    "plugins": [
      "expo-router",
      "@bacons/apple-targets",
      "./plugins/withAppleTargetSchemes",
      "./plugins/withIosSceneLifecycle",
      "./plugins/withAndroidReleaseOptimization",
      "./plugins/withQuranRecitationRuntime",
      [
        "expo-audio",
        {
          "microphonePermission": "Use the microphone only when you choose Quran voice search, private recording or Recite Assist. Audio stays on this device and is not uploaded.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Your location is used only while Qibla is open to calculate the direction of the Qibla."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/hbic-splash-mark.png",
          "color": "#0C9BA8",
          "defaultChannel": "community_updates_v1",
          "enableBackgroundRemoteNotifications": true,
          "sounds": [
            "./assets/audio/adhan_madinah_marwan_qassas_short.wav"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "79283015-cb87-48ef-9761-81ab87641205"
      }
    },
    "owner": "hbiccas-team"
  }
}
