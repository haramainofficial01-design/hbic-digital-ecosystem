{
  "cli": {
    "version": ">= 20.5.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "qaSimulator": {
      "environment": "production",
      "distribution": "internal",
      "ios": {
        "image": "macos-tahoe-26.6-xcode-27.1",
        "env": {
          "SHARP_IGNORE_GLOBAL_LIBVIPS": "1"
        },
        "simulator": true
      }
    },
    "qaAndroid": {
      "environment": "production",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "image": "macos-tahoe-26.6-xcode-27.1",
        "env": {
          "SHARP_IGNORE_GLOBAL_LIBVIPS": "1"
        }
      },
      "env": {
        "EXPO_PUBLIC_QURAN_ENABLED": "true",
        "EXPO_PUBLIC_QURAN_PRODUCTION_READY": "true",
        "EXPO_PUBLIC_QURAN_CONTENT_SOURCE": "qf",
        "EXPO_PUBLIC_RECITE_ASSIST_ENABLED": "true",
        "EXPO_PUBLIC_API_URL": "https://hbic.ca"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "production",
        "releaseStatus": "draft"
      }
    },
    "androidClosed": {
      "android": {
        "track": "alpha",
        "releaseStatus": "completed",
        "applicationId": "ca.hbic.calgary.app"
      }
    },
    "store": {
      "ios": {
        "ascAppId": "6790937097",
        "bundleIdentifier": "ca.hbic.calgary.app"
      },
      "android": {
        "track": "production",
        "releaseStatus": "completed",
        "applicationId": "ca.hbic.calgary.app"
      }
    }
  }
}
