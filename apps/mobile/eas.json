{
  "cli": {
    "version": ">= 20.5.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "production",
        "releaseStatus": "draft"
      }
    },
    "androidClosed": {
      "android": {
        "track": "alpha",
        "releaseStatus": "completed",
        "applicationId": "ca.hbic.calgary.app"
      }
    },
    "store": {
      "ios": {
        "ascAppId": "6790937097",
        "bundleIdentifier": "ca.hbic.calgary.app"
      },
      "android": {
        "track": "production",
        "releaseStatus": "completed",
        "applicationId": "ca.hbic.calgary.app"
      }
    }
  }
}
