{
  "framework": "nextjs",
  "installCommand": "npm ci --legacy-peer-deps --ignore-scripts --no-audit --fund=false",
  "buildCommand": "npm run build:web",
  "outputDirectory": "apps/public-web/.next",
  "crons": [
    { "path": "/api/prayer/weekly-notifications", "schedule": "0 6 * * 0" },
    { "path": "/api/academy/cash-reminders", "schedule": "0 15 * * *" },
    { "path": "/api/academy/email-dispatch", "schedule": "0 16 * * *" }
  ],
  "alias": [
    "hbic-calgary.vercel.app",
    "hbic-calgary-app.vercel.app",
    "hbic.ca",
    "www.hbic.ca"
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.hbic.ca"
        }
      ],
      "destination": "https://hbic.ca/$1",
      "permanent": true
    }
  ]
}
